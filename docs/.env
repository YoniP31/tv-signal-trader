# tv-signal-trader configuration template.
#
# Copy/rename this file to ".env" and put it next to tv-signal-trader.exe
# (or in the repo root when running from source), then fill in the fields
# you need. Anything left blank just isn't configured -- e.g. you'll be
# prompted for TradingGenerator credentials and at least one Tradovate
# account on first run if they're empty here, and you can type "setup" at
# the ">" prompt anytime to add/change more.

# --- TradingGenerator login (required) ---
TRADINGGENERATOR_USERNAME=
TRADINGGENERATOR_PASSWORD=

# --- Tradovate accounts -- one per prop firm you trade. Fill in only the
# firms you actually use; leave the rest blank. ---
TRADOVATE_APEX_TRADER_FUNDING_USERNAME=
TRADOVATE_APEX_TRADER_FUNDING_PASSWORD=
TRADOVATE_TOPSTEP_USERNAME=
TRADOVATE_TOPSTEP_PASSWORD=
TRADOVATE_TRADEIFY_USERNAME=
TRADOVATE_TRADEIFY_PASSWORD=
TRADOVATE_MYFUNDEDFUTURES_USERNAME=
TRADOVATE_MYFUNDEDFUTURES_PASSWORD=
TRADOVATE_TAKE_PROFIT_TRADER_USERNAME=
TRADOVATE_TAKE_PROFIT_TRADER_PASSWORD=
TRADOVATE_BULENOX_USERNAME=
TRADOVATE_BULENOX_PASSWORD=
TRADOVATE_ELITE_TRADER_FUNDING_USERNAME=
TRADOVATE_ELITE_TRADER_FUNDING_PASSWORD=
TRADOVATE_LEELOO_TRADING_USERNAME=
TRADOVATE_LEELOO_TRADING_PASSWORD=

# --- Account balance limits, per account size (optional) ---
# An account is pulled from TradingGenerator automatically once its balance
# drops to/below MIN or rises to/above MAX. MAX is split by account type
# (EVAL vs LIVE) since profit targets genuinely differ between the two;
# MIN (the max-loss side) is shared. These are the built-in defaults --
# uncomment and edit only if you need to override them.
ACCOUNT_25K_MIN_BALANCE=23000
ACCOUNT_25K_MAX_BALANCE_EVAL=27000
ACCOUNT_25K_MAX_BALANCE_LIVE=27000
ACCOUNT_50K_MIN_BALANCE=47500
ACCOUNT_50K_MAX_BALANCE_EVAL=53000
ACCOUNT_50K_MAX_BALANCE_LIVE=53500

# --- Max concurrent positions per company, web_multi only (optional) ---
# At most this many open positions at a single company at once. This is
# the built-in default.
MAX_POSITIONS_PER_COMPANY=3

# --- Randomized polling delays, seconds, web_multi only (optional) ---
# Every repeated check in web_multi's loop sleeps a random duration between
# MIN and MAX instead of a fixed interval. POSITION_POLL is used while
# waiting on an open position or a not-yet-eligible signal; PORTFOLIO_RETRY
# is used when every known portfolio is locked/unavailable. These are the
# built-in defaults (both fixed at the old hardcoded values) -- widen the
# range to make the cadence less predictable.
POSITION_POLL_MIN_SECONDS=20
POSITION_POLL_MAX_SECONDS=20
PORTFOLIO_RETRY_MIN_SECONDS=60
PORTFOLIO_RETRY_MAX_SECONDS=60

# --- Daily profit limit, $ (optional, used by web_multi) ---
# Once an account's Total P/L (Tradovate's broker-panel Account Summary
# tab, resets daily) reaches this amount, that account stops opening new
# trades until the next session day. Leave commented out to disable (no
# built-in default -- this is an opt-in risk control). Example value only.
#DAILY_PROFIT_LIMIT=500

# --- Take-profit cap buffer, $ (optional, used by web_multi) ---
# If a trade's take-profit would push an account's balance past its max
# (above), the TP is shrunk so the result lands at max + a random buffer in
# this range instead of blowing far past it. These are the built-in
# defaults.
TP_CAP_BUFFER_MIN=50
TP_CAP_BUFFER_MAX=200

# --- Trading session window, Israel time, 24-hour HH:MM (optional) ---
# Leave commented out (as below) to allow trading at any time. If set, the
# app waits for the window to open and stops generating new trades once it
# closes each day, resuming automatically the next day. There is no
# built-in default -- these are just example values.
#SESSION_START_TIME=09:00
#SESSION_END_TIME=17:00

# --- No-trade window, Israel time, 24-hour HH:MM (optional, used by
# web_multi) ---
# A second, optional window inside the session above where no *new* trades
# are started (e.g. a lunch break) -- positions already open keep running.
# Leave commented out to disable. No built-in default -- example values only.
#NO_TRADE_START_TIME=12:00
#NO_TRADE_END_TIME=13:00
