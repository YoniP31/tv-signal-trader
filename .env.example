# You shouldn't need to create this file by hand — running `python main.py`
# walks you through setup interactively the first time anything below is
# missing, and writes the answers here. Type 'setup' at the '>' prompt to
# change any of them later. Documented here just for reference.

# Full path to your chromedriver executable (must match your installed
# Chrome version — see https://googlechromelabs.github.io/chrome-for-testing/).
CHROMEDRIVER_PATH=

# TradingGenerator login. Used only as a fallback if the persistent Chrome
# profile doesn't already have a logged-in session there (e.g. first run, or
# after the session expires).
#
# TradingView itself does not need credentials here — it stays logged in via
# the persistent browser profile (tv_profile/), log in there once manually.
TRADINGGENERATOR_USERNAME=
TRADINGGENERATOR_PASSWORD=
