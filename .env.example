# Copy this file to .env and fill in your TradingGenerator credentials.
# Used only as a fallback if the persistent Chrome profile doesn't already
# have a logged-in session there (e.g. first run, or after the session expires).
#
# TradingView itself does not need credentials here — it stays logged in via
# the persistent browser profile (tv_profile/), log in there once manually.
TRADINGGENERATOR_USERNAME=
TRADINGGENERATOR_PASSWORD=
