# Chrome / Selenium (chromedriver itself is auto-downloaded by Selenium
# Manager into its own cache dir, not this repo)
tv_profile/
*.profile/

# Screenshots produced by the bot at runtime
*.png
!docs/**/*.png

# Generated runtime status file
status.json

# Generated runtime debug log (rotated backups: app.log.1, .2, .3)
app.log*

# Nuitka build output (published via GitHub Releases, not tracked in git)
/dist/
*.build/
*.onefile-build/
*.dist/
nuitka-crash-report.xml

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Secrets / local config
.env
*.env.local
!docs/.env

# Your own "add_accounts" command input -- see docs/accounts_to_add.txt
# for the committed template
accounts_to_add.txt
!docs/accounts_to_add.txt

# OS cruft
.DS_Store
Thumbs.db
